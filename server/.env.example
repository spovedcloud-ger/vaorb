# MongoDB Atlas — VA0rbit cluster
# Option A: full connection string (recommended)
MONGO_URI=mongodb+srv://dbvaorb:<db_password>@va0rbit.4axc3iu.mongodb.net/vaorb?retryWrites=true&w=majority&appName=VA0rbit

# Option B: build URI from parts (used when MONGO_URI is empty)
# MONGO_USER=dbvaorb
# MONGO_PASSWORD=
# MONGO_CLUSTER=va0rbit.4axc3iu.mongodb.net
# MONGO_DB=vaorb
# MONGO_APP_NAME=VA0rbit

PORT=5000
NODE_ENV=development

# Contact email — receives form notifications & appears on the site
CONTACT_EMAIL=accounts@thevaorbit.com
SITE_NAME=The VA Orbit

# SMTP — required for "Start The Conversation" form emails (Gmail, SendGrid, etc.)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password for SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: from address (defaults to SMTP_USER)
# MAIL_FROM=noreply@thevaorbit.com

# --- Unique Google Meet per booking (Google Calendar API) ---
# API keys (AIza...) alone CANNOT create calendar events or Meet links.

# Option A — OAuth (sign in once as accounts@thevaorbit.com):
#   Enable Calendar API → Create OAuth 2.0 Client ID (not API key)
#   Add CLIENT_ID + SECRET below, then run: node scripts/google-calendar-auth.mjs
GOOGLE_OAUTH_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-secret
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth2callback
GOOGLE_CALENDAR_ID=accounts@thevaorbit.com

# Option B — Service account + Workspace domain-wide delegation:
# GOOGLE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_IMPERSONATE=accounts@thevaorbit.com

# Optional: restrict API key to your site (analytics/maps only — not used for Meet)
# GOOGLE_API_KEY=

# Fallback: one shared Meet room if Calendar auth is not configured
GOOGLE_MEET_LINK=https://meet.google.com/your-room-code

# Set to true to upsert default pricing plans on every server start
SYNC_PRICING_ON_START=false

# Set to true if a corporate VPN/proxy breaks MongoDB TLS
# MONGO_TLS_INSECURE=true
