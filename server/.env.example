# MongoDB Atlas — VA0rbit cluster
# Option A: full connection string (recommended)
MONGO_URI=mongodb+srv://dbvaorb:<db_password>@va0rbit.4axc3iu.mongodb.net/vaorb?retryWrites=true&w=majority&appName=VA0rbit

# Option B: build URI from parts (used when MONGO_URI is empty)
# MONGO_USER=dbvaorb
# MONGO_PASSWORD=
# MONGO_CLUSTER=va0rbit.4axc3iu.mongodb.net
# MONGO_DB=vaorb
# MONGO_APP_NAME=VA0rbit

PORT=5000
NODE_ENV=development

# Contact email shown in chat fallbacks and notifications
CONTACT_EMAIL=accounts@thevaorbit.com

# Set to true to upsert default pricing plans on every server start
SYNC_PRICING_ON_START=false

# Set to true if a corporate VPN/proxy breaks MongoDB TLS
# MONGO_TLS_INSECURE=true
