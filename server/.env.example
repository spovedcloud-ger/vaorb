# MongoDB Atlas — VA0rbit cluster
# Option A: full connection string (recommended)
MONGO_URI=mongodb+srv://dbvaorb:<db_password>@va0rbit.4axc3iu.mongodb.net/vaorb?retryWrites=true&w=majority&appName=VA0rbit

# Option B: build URI from parts (used when MONGO_URI is empty)
# MONGO_USER=dbvaorb
# MONGO_PASSWORD=
# MONGO_CLUSTER=va0rbit.4axc3iu.mongodb.net
# MONGO_DB=vaorb
# MONGO_APP_NAME=VA0rbit

PORT=5000
NODE_ENV=development

# Contact email — receives form notifications & appears on the site
CONTACT_EMAIL=accounts@thevaorbit.com
SITE_NAME=The VA Orbit

# SMTP — required for "Start The Conversation" form emails (Gmail, SendGrid, etc.)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password for SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: from address (defaults to SMTP_USER)
# MAIL_FROM=noreply@thevaorbit.com

# Google Meet room link included in booking confirmation emails (required for Meet links)
# Create one at https://meet.google.com/ or from Google Calendar → event → Meet link
GOOGLE_MEET_LINK=https://meet.google.com/your-room-code

# Set to true to upsert default pricing plans on every server start
SYNC_PRICING_ON_START=false

# Set to true if a corporate VPN/proxy breaks MongoDB TLS
# MONGO_TLS_INSECURE=true
